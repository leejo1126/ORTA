# Data & outputs (large, regenerable)
data/
*.zarr/
*.h5ad
*.tif
*.tiff
*.png
*.npz
*.npy

# Experiment output tiers (see CLAUDE.md):
#   data/    -> ignored above (machine-generated, regenerable)
#   scratch/ -> ignored (throwaway vibe-checks)
#   results/ -> TRACKED (curated keepers), except heavy binaries which stay out
scratch/
!**/results/
!**/results/**
**/results/**/*.tif
**/results/**/*.tiff
**/results/**/*.h5ad
**/results/**/*.npz
**/results/**/*.npy
**/results/**/*.zarr/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# Snakemake
.snakemake/

# transient run logs (HPC/local stdout+stderr)
logs/
IF/logs/

# Secrets (never commit API keys)
.env
*.key
.secrets/
agents/.anthropic_key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# agent run records (agents/runs/{tuning,autofoci}/): keep the structured text trail
# (stats/verdict JSON, HISTORY.md, history.jsonl, trials.jsonl, leaderboard.md, proposed
# specs) under version control as the audit trail. Montages are *.png (ignored above),
# regenerable, and referenced by path from the records.
